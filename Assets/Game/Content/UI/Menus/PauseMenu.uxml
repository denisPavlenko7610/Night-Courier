<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="project://database/Packages/com.rd.presentation/Menus/Runtime/UI/Menus.uss" />
    <Style src="../Theme/NightCourier.uss" />
    <ui:Template name="SettingsScreen" src="SettingsScreen.uxml" />
    <ui:Template name="ControlsScreen" src="ControlsScreen.uxml" />
    <ui:Template name="ConfirmDialog" src="ConfirmDialog.uxml" />
    <ui:VisualElement name="layer" class="nc-theme nc-layer" picking-mode="Ignore">
        <ui:VisualElement name="menu" class="rd-screen nc-pause">
            <ui:VisualElement class="rd-screen__content nc-panel nc-panel--narrow">
                <ui:Label name="menu-title" class="rd-screen__title" />
                <ui:VisualElement name="menu-entries" class="rd-menu__entries" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Instance template="SettingsScreen" name="settings-instance" class="nc-slot" picking-mode="Ignore" />
        <ui:Instance template="ControlsScreen" name="controls-instance" class="nc-slot" picking-mode="Ignore" />
        <ui:Instance template="ConfirmDialog" name="confirm-instance" class="nc-slot" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
