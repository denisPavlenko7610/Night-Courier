.nc-result {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 8, 7, 0.92);
}

.nc-result .nc-result__frame {
    width: 1400px;
    max-width: 100%;
    padding: 44px 60px 40px 60px;
    background-color: rgb(20, 21, 20);
    border-top-width: 5px;
    border-top-color: rgb(213, 161, 107);
}

.nc-result .nc-result__title {
    -unity-font: url("../../../../ThirdParty/IBMPlex/IBMPlexSans-SemiBold.ttf");
    font-size: 56px;
    color: rgb(235, 231, 219);
    -unity-text-align: middle-center;
}

.nc-result .nc-result__subtitle {
    font-size: 28px;
    color: rgb(168, 170, 160);
    -unity-text-align: middle-center;
    margin: 8px 40px 0 40px;
    padding-bottom: 18px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(235, 231, 219, 0.22);
}

.nc-result .nc-result__top {
    flex-direction: row;
    margin-top: 4px;
}

.nc-result .nc-receipt {
    width: 650px;
    flex-shrink: 0;
    padding: 20px 26px;
    background-color: rgb(216, 216, 198);
}

.nc-result .nc-receipt__caption {
    font-size: 24px;
    color: rgb(100, 105, 94);
}

.nc-result .nc-receipt__lines {
    flex-direction: row;
    flex-grow: 1;
    min-height: 190px;
    margin-top: 8px;
}

.nc-result .nc-receipt__labels {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 28px;
    color: rgb(40, 45, 38);
}

.nc-result .nc-receipt__values {
    flex-shrink: 0;
    font-size: 28px;
    color: rgb(40, 45, 38);
    -unity-text-align: upper-right;
}

.nc-result .nc-receipt__total {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgba(40, 45, 38, 0.5);
}

.nc-result .nc-receipt__total-label {
    -unity-font: url("../../../../ThirdParty/IBMPlex/IBMPlexSans-SemiBold.ttf");
    font-size: 40px;
    color: rgb(40, 45, 38);
}

.nc-result .nc-receipt__total-value {
    -unity-font: url("../../../../ThirdParty/IBMPlex/IBMPlexSans-SemiBold.ttf");
    font-size: 44px;
    color: rgb(43, 97, 62);
}

.nc-result .nc-rating {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    margin-left: 30px;
}

.nc-result .nc-rating__caption {
    font-size: 26px;
    color: rgb(168, 170, 160);
    margin-top: 8px;
}

.nc-result .nc-rating__grade {
    -unity-font: url("../../../../ThirdParty/IBMPlex/IBMPlexSans-SemiBold.ttf");
    font-size: 150px;
    color: rgb(235, 231, 219);
    -unity-text-align: middle-center;
}

.nc-result .nc-rating__axes {
    font-size: 28px;
    color: rgb(235, 231, 219);
    -unity-text-align: middle-center;
    white-space: pre-wrap;
}

.nc-result .nc-rating__rank {
    font-size: 28px;
    color: rgb(235, 231, 219);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 22px;
}

.nc-result .nc-result__stats {
    font-size: 26px;
    color: rgb(235, 231, 219);
    -unity-text-align: middle-center;
    white-space: pre-wrap;
    margin-top: 28px;
}

.nc-result .nc-result__advice {
    font-size: 28px;
    color: rgb(235, 231, 219);
    white-space: pre-wrap;
    margin: 18px 0 0 0;
}

.nc-result .nc-result__failure {
    align-items: center;
    padding: 70px 40px 40px 40px;
}

.nc-result .nc-result__failure-message {
    -unity-font: url("../../../../ThirdParty/IBMPlex/IBMPlexSans-SemiBold.ttf");
    font-size: 40px;
    color: rgb(235, 231, 219);
    -unity-text-align: middle-center;
    white-space: normal;
}

.nc-result .nc-result__failure-footer {
    font-size: 30px;
    color: rgb(168, 170, 160);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 50px;
}

.nc-result .nc-result__credits {
    -unity-font: url("../../../../ThirdParty/IBMPlex/IBMPlexMono-Regular.ttf");
    font-size: 32px;
    color: rgb(168, 170, 160);
    -unity-text-align: middle-center;
    margin-top: 34px;
}

.nc-result .nc-result__return {
    align-self: center;
    width: 440px;
    height: 76px;
    margin: 16px 0 0 0;
    font-size: 32px;
    color: rgb(235, 231, 219);
    background-color: rgb(46, 52, 44);
    border-width: 0;
    border-radius: 0;
    -unity-text-align: middle-center;
}

.nc-result .nc-result__return:hover {
    background-color: rgb(62, 70, 59);
}

.nc-result .nc-result__return:focus {
    border-width: 2px;
    border-color: rgb(213, 161, 107);
}

.nc-result .nc-result__return:disabled {
    color: rgb(168, 170, 160);
    background-color: rgb(30, 33, 29);
}
