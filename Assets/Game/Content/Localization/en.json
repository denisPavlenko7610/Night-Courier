		{ "Key": "contract.standard_delivery.title", "Value": "Standard Delivery" },
		{ "Key": "contract.standard_delivery.order", "Value": "Work order 0113-A" },
		{ "Key": "contract.standard_delivery.description", "Value": "A routine parcel for Greyline Warehouse. No special handling." },
		{ "Key": "contract.standard_delivery.notes", "Value": "Switch on the breaker to power the route.\nScan the parcel before delivery." },
		{ "Key": "contract.standard_delivery.memo", "Value": "Dispatch: the parcel is not ticking. If that changes, see Rule 13." },

		{ "Key": "contract.fragile.title", "Value": "Fragile" },
		{ "Key": "contract.fragile.order", "Value": "Work order 0114-C" },
		{ "Key": "contract.fragile.description", "Value": "A fragile specimen case for the Greyline lab. Deliver it intact." },
		{ "Key": "contract.fragile.notes", "Value": "Set the case down only on the dock crate or scanner plate.\nFalls, hard hits and the electric floor damage it.\nViolations escalate from unstable cargo to an alarm, a leak and contract failure." },
		{ "Key": "contract.fragile.memo", "Value": "Legal reminds you that the specimen is not covered by courier insurance. Neither are you." },

		{ "Key": "contract.lights_out.title", "Value": "Lights Out" },
		{ "Key": "contract.lights_out.order", "Value": "Work order 0115-B" },
		{ "Key": "contract.lights_out.description", "Value": "The warehouse is dark and the cargo is already on site. Restore the lights." },
		{ "Key": "contract.lights_out.notes", "Value": "Do not leave the package in darkness for more than ten seconds. Lit spots are safe.\nThe breaker is dead and the dock is sealed.\nProperty damage is billed to the courier." },
		{ "Key": "contract.lights_out.memo", "Value": "Facilities says the outage was scheduled. Nobody scheduled it." },

		{ "Key": "contract.express.title", "Value": "Rush Delivery" },
		{ "Key": "contract.express.order", "Value": "Work order 0116-R" },
		{ "Key": "contract.express.description", "Value": "Deliver before the deadline. Late delivery is a violation." },
		{ "Key": "contract.express.notes", "Value": "The clock starts when you arrive at the warehouse.\nThe maintenance route is free of fines but a security drone patrols it.\nThe barricade shortcut costs a fine and crawlers wait on the south floor." },
		{ "Key": "contract.express.memo", "Value": "Late deliveries are reported to the Delivery Compliance Office. It is not a real office." },

		{ "Key": "contract.restricted_cargo.title", "Value": "Restricted Cargo" },
		{ "Key": "contract.restricted_cargo.order", "Value": "Work order 0117-K" },
		{ "Key": "contract.restricted_cargo.description", "Value": "Restricted cargo in a dark building with security on patrol. Do not ask what is inside." },
		{ "Key": "contract.restricted_cargo.notes", "Value": "The package must not be dropped and must not stay in darkness.\nCarrying it keeps your hands full. You cannot fight while you hold it.\nA clean run pays a bonus." },
		{ "Key": "contract.restricted_cargo.memo", "Value": "The recipient says they have been waiting for it. They said it twice." },

