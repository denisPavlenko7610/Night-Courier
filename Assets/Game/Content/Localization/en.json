		{ "Key": "rule.do_not_drop.brief", "Value": "Set it down only on the dock crate or the scanner plate. Falls and hard hits damage it." },
		{ "Key": "rule.keep_in_light.brief", "Value": "Ten seconds in darkness breaks the rule. Without power, only the dock lamp is safe." },
		{ "Key": "rule.delivery_deadline.brief", "Value": "Deliver before the clock runs out." },
		{ "Key": "rule.do_not_drop.hint", "Value": "Do not drop. Use the dock crate or scanner plate; avoid hard impacts." },
		{ "Key": "rule.keep_in_light.hint", "Value": "Keep in light. Ten seconds in darkness breaks the rule. Until power returns, only the dock lamp is safe." },
		{ "Key": "rule.delivery_deadline.hint", "Value": "Deliver on time. Both routes take about the same; fights and detours cost the clock." },
		{ "Key": "rule.do_not_drop.advice", "Value": "Do not drop: set the package down only on the dock crate or the scanner plate, and avoid falls and fights while carrying it." },
		{ "Key": "rule.keep_in_light.advice", "Value": "Keep in light: restore the power first and keep the package out of the dark." },
		{ "Key": "rule.delivery_deadline.advice", "Value": "Too slow: skip detours and fights." },
