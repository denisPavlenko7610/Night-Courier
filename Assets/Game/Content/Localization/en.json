		{ "Key": "hud.objective", "Value": "Objective" },
		{"Key": "training.caption", "Value": "MANDATORY TRAINING 4-B | {0}/{1}"},
		{"Key": "training.objective.accept_contract", "Value": "Welcome, courier. Move with WASD, look with the mouse. Use the yellow contract terminal; read and accept the first job. Esc opens pause."},
		{"Key": "training.objective.pick_up_from_conveyor", "Value": "Collect your parcel from the conveyor. Aim at it and follow the interaction prompt; hold until the bar fills when shown."},
		{"Key": "training.objective.load_van", "Value": "Carry the parcel to the van and use its yellow loading point to travel. G puts cargo down. You do not drive on this shift."},
		{"Key": "training.objective.pick_up_package", "Value": "Collect the parcel beside the van. Aim at yellow equipment for prompts. Find the breaker panel to power the delivery route."},
		{"Key": "training.objective.restore_power", "Value": "Use the yellow breaker panel. It powers the scanner, lift and door. You can operate equipment while carrying the parcel."},
		{"Key": "training.objective.scan_package", "Value": "Carry the parcel into the delivery room. Aim over the scanner plate and press G to set it down on the plate."},
		{"Key": "training.objective.scanning", "Value": "Leave the parcel on the scanner plate until its light turns green. Taking it early cancels the scan."},
		{"Key": "training.objective.pick_up_scanned", "Value": "Scan approved. Pick up the parcel again, then follow the green destination marker to the delivery terminal."},
		{"Key": "training.objective.deliver_package", "Value": "With the scanned parcel in hand, use the green delivery terminal. Your payment and grade appear after delivery."},
		{ "Key": "objective.accept_contract", "Value": "Open the contract terminal and accept a contract." },
		{ "Key": "objective.pick_up_from_conveyor", "Value": "Pick up the parcel from the conveyor." },
		{ "Key": "objective.load_van", "Value": "Carry the parcel to the van and load it." },
		{ "Key": "objective.pick_up_package", "Value": "Pick up the package." },
		{ "Key": "objective.find_battery", "Value": "Find the battery at the far end of the dock. It takes both hands." },
		{ "Key": "objective.insert_battery", "Value": "Carry the battery to the generator." },
		{ "Key": "objective.park_package", "Value": "Put the package down on the lit dock crate. The battery needs both hands." },
		{ "Key": "objective.restore_power", "Value": "Switch on the breaker panel. The scanner, lift and door run on it." },
		{ "Key": "objective.scan_package", "Value": "Set the package on the scanner plate in the delivery room." },
		{ "Key": "objective.scanning", "Value": "Scanning. Leave the package on the plate until the light turns green." },
		{ "Key": "objective.pick_up_scanned", "Value": "Scan complete. Pick up the package and take it to the delivery terminal." },
		{ "Key": "objective.deliver_package", "Value": "Take the package to the delivery terminal." },

